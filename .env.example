# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ilan ozetleri icin AI saglayicisi: "gemini" (su an) veya "openai" (gece aktif
# edilince buraya "openai" yazip asagidaki OPENAI_API_KEY'i doldurmak yeterli.
AI_PROVIDER=gemini

# Gemini: aistudio.google.com/apikey adresinden alinir
GEMINI_API_KEY=

# OpenAI: platform.openai.com/api-keys adresinden alinir (henuz aktif degil)
OPENAI_API_KEY=

# API
PORT=3000

# Tarama: sirketler arasi anti-ban gecikmesi (ms). Vercel'in fonksiyon sure
# sinirina takilmamak icin dakikalar degil saniyeler mertebesindedir.
SCAN_MIN_DELAY_MS=1500
SCAN_MAX_DELAY_MS=3000

# Eksik ozetleri getirirken TTSG'nin captcha esigini zorlamamak icin ilanlar
# arasi bekleme (ms) - extension/background.js icindeki sabitlerle hizali.
SCAN_HISTORY_WINDOW_DAYS=7

# Sirket eklerken otomatik sicil muduerluegue tespiti: TUM sicil muduerluklerini
# (~140) tek bir unvan icin tarar, o yuzden SCAN_MIN/MAX_DELAY_MS'den daha kisa
# bir gecikme kullanir (yoksa tek sirket icin tespit ~5 dk surer).
DETECT_MIN_DELAY_MS=300
DETECT_MAX_DELAY_MS=700
